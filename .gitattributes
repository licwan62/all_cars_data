# 流水线交付物和历史批次按字节保存：manifest 记录的是发布时的原始 sha256，
# 检出时若被 core.autocrlf 转换换行，下游（如网站流水线）的 sha256 校验会失败。
**/output/** -text
**/artifacts/** -text

# Historical candidate hashes identify original bytes on every platform.
**/data/历史导入/** -text

# Evidence manifest records the canonical raw SHA-256 of this text source.
nodes/01.整理尺寸库/data/data_source/trimslate-vehicles.csv text eol=lf

# Central interfaces, offline HTML and relocated raw evidence retain exact hashes
# when checked out on either Windows or a cloud Linux worker.
/json/** -text
/nodes/**/*.html -text
/nodes/M0.车型年覆盖/data/data_source/** -text

# The HTML fingerprint includes the exact builder and shared template bytes.
/lib/node_html.py text eol=lf
/lib/node_html_template.html text eol=lf

# A2 records raw SHA-256 for these build inputs in each website package.
/nodes/A2.网站发布/src/** -text
/nodes/A2.网站发布/data/** -text
/nodes/A2.网站发布/tests/** -text
