{
  "schema_version": 3,
  "governance": {
    "manifest_owner": "link-analysis",
    "manifest_owner_path": "D2.链接分析",
    "policy": "根目录 pipeline.json 由流水线最后节点 D2.链接分析维护。"
  },
  "directory_contract": {
    "data": "agent-maintained rules and reference material",
    "output": "current validated handoff for downstream agents (stable names, no version suffix) plus manifest.json",
    "artifacts": "immutable per-run history; deliverables saved as 名称-YYYYMMDD_NN.ext"
  },
  "naming_contract": "上游 00-03 用数字前缀=层号（最长上游链长度）。从尺码计算起按最终产物分线：A 全量表、B 定制评分、C 代表车型、D 发货单、X 旁路分析；A0 尺码计算是各线共用枢纽，线内序号自 1 递增，且大于线内上游的序号。个别线允许自己的 0 号节点作为线内独立枢纽（不依赖同线节点，可以没有任何上游，例如 B0 差评分析承接人工维护台账），序号规则同样适用（线内后续序号必须大于它）。",
  "release_contract": "python scripts/publish_release.py 自上游到下游发布：artifact 内交付物带 -YYYYMMDD_NN 后缀，发布到 output/ 时去掉后缀，manifest.json 记录交付物 sha256、artifact 来源与上游版本；根目录 release.json 汇总。outputs 只列已存在的稳定交付物，未产出的写入 pending。",
  "nodes": [
    {
      "id": "dimension-crawler",
      "path": "00.自动化尺寸抓取器",
      "layer": 0,
      "line": "U",
      "role": "upstream",
      "upstream": [],
      "outputs": [],
      "pending": [
        "区域尺寸抓取候选"
      ],
      "release_notes": [
        "抓取产物目前只保存在 artifacts，尚无稳定 output"
      ]
    },
    {
      "id": "dimension-library",
      "path": "01.整理尺寸库",
      "layer": 1,
      "line": "U",
      "role": "upstream",
      "upstream": [
        "dimension-crawler"
      ],
      "outputs": [
        "尺寸库.csv",
        "尺寸库_US.csv",
        "尺寸库_EU.csv",
        "尺寸库_RU.csv"
      ],
      "pending": []
    },
    {
      "id": "structure-review",
      "path": "02.分类结构审核",
      "layer": 2,
      "line": "U",
      "role": "upstream",
      "upstream": [
        "dimension-library"
