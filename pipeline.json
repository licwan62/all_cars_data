      "outputs": [
        "原子销量.csv"
      ],
      "pending": [],
      "release_notes": [
        "原子销量已从找回的 atom_sales.csv 校验后按稳定文件名发布"
      ]
    },
    {
      "id": "code-mapping",
      "path": "02.代码映射",
      "layer": 2,
      "line": "U",
      "role": "upstream",
      "upstream": [
        "dimension-library"
      ],
      "outputs": [
        "车型编码映射.csv",
        "尺寸编码映射.csv"
      ],
      "pending": []
    },
    {
      "id": "shape-classification",
      "path": "03.车形分类核定",
      "layer": 3,
      "line": "U",
      "role": "upstream",
      "upstream": [
        "dimension-library",
        "structure-review"
      ],
      "outputs": [
        "车形分类.csv"
      ],
      "pending": []
    },
    {
      "id": "size-calculation",
      "path": "A0.尺码计算",
      "layer": 4,
      "line": "A",
      "index": 0,
      "role": "final",
