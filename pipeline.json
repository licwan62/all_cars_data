      "outputs": [
        "车型结构.csv",
        "车型结构_US.csv",
        "车型结构_EU.csv",
        "车型结构_RU.csv"
      ],
      "pending": [],
      "release_notes": [
        "2026-09-23 改为按 data/分类标准.json（三国通用 结构→分类）与 data/分类联网判定.csv（Liftback/Fastback 车型级联网判定）重算分类；只改 分类，DIMENSION-ID 不变；输出全量与分区域文件"
      ]
    },
    {
      "id": "sales-estimation",
      "path": "02.销量评估",
      "layer": 2,
      "line": "U",
      "role": "upstream",
      "upstream": [
        "dimension-library"
