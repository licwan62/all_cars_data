ry":"local","imageinfo":[{"size":4468010,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg/960px-1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg/1920px-1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg/960px-1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/75/1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg/1920px-1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/75/1993_Ford_Mustang_Saleen_SC_Convertible_%2814228540957%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1993_Ford_Mustang_Saleen_SC_Convertible_(14228540957).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=40645589","extmetadata":{"DateTime":{"value":"2015-06-01 01:49:56","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1993 Ford Mustang Saleen SC Convertible (14228540957)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images reviewed by FlickreviewR|Saleen Mustang|1993 Ford automobiles|Files with coordinates missing SDC location of creation|United States photographs taken on 2014-04-18|Photographs by Sicnag|Ford Mustang Convertible (1987-1993)","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"35.351940","source":"commons-desc-page"},"GPSLongitude":{"value":"-80.682220","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Canary Yellow. \nThe 3rd generation Fox body Mustang was made from 1979-1993, a minor update to front and rear in 1983, and again in 1985, then a more substantial update in 1987 saw the grille and quad headlights replaced by modern single headlights and the no grille aero look.\nOnly models available were the LX and GT and just the 2.3 litre 4 and 5.0 V8, still coupe, hatchback and convertible. \nSaleen manufactured limited edition, high-performance Mustangs. The SC was produced from 1990 to 93. Only 3 hatchbacks and 2 convertibles in 1993. They got the Vortech Supercharger making 291 hp.\n</p>\nPhotographed at the 50th Anniversary of the Mustang celebrations at the Charlotte Motor Speedway, April 2014","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-04-18 05:37","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/14228540957/\">1993 Ford Mustang Saleen SC Convertible</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-d