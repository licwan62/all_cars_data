    cursor: pointer;
  }

  dialog[data-share-modal] > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  dialog[data-share-modal] > div:first-child {
    justify-content: flex-end;
    border: none;
  }

  dialog[data-share-modal] > div:nth-child(2) {
    border-bottom: 2px solid rgb(222, 226, 230);
    margin-top: 10px;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
