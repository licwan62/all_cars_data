        <h2 class="release-banner__title" >
            2023 Nissan Z Specifications
        </h2>

        
        

        <article id="release-f34959dc65fa6147308490ca57156bce">
            

            

            <div id="overview" class="row">
                <div class="col-12">
                    <div id="releaseBody" class="row">
                        <div class="col-12">
                            <p class="publication">
                                
                                    <date class="published-at published published-show">

        <time class="pub-date" datetime="2022-05-23T15:37:55Z">
          May 23, 2022
        </time>
      
</date>

                                    
                                
                            </p>

                            <div class="release__in-brief d-block d-md-none">
                              
                            </div>

                            <w-release>
                                <p><em>Specifications are based on latest product information available at the time of release</em></p>
<p><strong>Mechanical</strong></p>
<table class="table" border="1">
<tbody>
<tr>
<td colspan="5"><strong>Engine</strong></td>
<td colspan="9" align="center"><strong>Sport</strong></td>
<td colspan="6" align="center"><strong>Performance</strong></td>
</tr>
<tr>
<td colspan="5">Name</td>
<td colspan="15" align="center">VR30DDTT 3.0L V6 Twin Turbo</td>
</tr>
<tr>
<td colspan="5">Cam design</td>
<td colspan="15" align="center">DOHC</td>
</tr>
<tr>
<td colspan="5">Orientation</td>
<td colspan="15" align="center">Longitudinal</td>
</tr>
<tr>
<td colspan="5">Cylinders / configuration</td>
<td colspan="15" align="center">V6</td>
</tr>
<tr>
<td colspan="5">Block / head composition</td>
<td colspan="15" align="center">Aluminum/aluminum</td>
</tr>
<tr>
<td colspan="5">Displacement (liters)</td>
<td colspan="15" align="center">3.0 / 2997</td>
</tr>
<tr>
<td colspan="5">Horsepower</td>
<td colspan="15" align="center">400 @ 6,400 rpm</td>
</tr>
<tr>
<td colspan="5">Torque (lb-ft)</td>
<td colspan="15" align="center">350 @ 1,600 - 5,200 rpm</td>
</tr>
<tr>
<td colspan="5">Bore &amp; stroke (mm)</td>
<td colspan="15" align="center">86.0 x 86.0</td>
</tr>
<tr>
<td colspan="5">Compression ratio</td>
<td colspan="15" align="center">10.3</td>
</tr>
<tr>
<td colspan="5">Maximum engine speed</td>
<td colspan="15" align="center">6,800 rpm</td>
</tr>
<tr>
<td colspan="5">Maximum boost pressure</td>
<td colspan="15" align="center">15 psi</td>
</tr>
<tr>
<td colspan="5">Induction system</td>
<td colspan="15" align="center">Twin turbochargers</td>
</tr>
<tr>
<td colspan="5">Valvetrain</td>
<td colspan="15" align="center">4 valves per cylinder; Continuously Variable Valve Timing Control System (CVTCS)</td>
</tr>
<tr>
<td colspan="5">Fuel delivery system</td>
<td colspan="15" align="center">Direct Injection Gasoline</td>
</tr>
<tr>
<td colspan="5">Engine oil cooler type</td>
<td colspan="15" align="center">Engine coolant</td>
</tr>
<tr>
<td colspan="5">Cooling fan type</td>
<td colspan="15" align="center">Electric</td>
</tr>
<tr>
<td colspan="5">Recommended fuel</td>
<td colspan="15" align="center">Premium unleaded</td>
</tr>
<tr>
<td colspan="5">Emissions system</td>
<td colspan="15" align="center">Closed loop feedback system w/ 4 catalysts</td>
</tr>
<tr>
<td colspan="5">Emissions certification level</td>
<td colspan="15" align="center">50 state: LEV2-LEV (CARB), Tier2-Bin5 (Fed)</td>
</tr>
<tr>
<td colspan="5">Exhaust</td>
<td colspan="9" align="center">Dual w/ chrome finishers</td>
<td colspan="6" align="center">Dual w/sport grade muffler</td>
</tr>
</tbody>
</table>
<p>&nbsp;</p>
<table class="table" border="1">
<tbody>
<tr>
<td colspan="2"><strong>Transmission and Drive System</strong></td>
<td width="155" align="center"><strong>Sport</strong></td>
<td width="125" align="center"><strong>Performance</strong></td>
</tr>
<tr>
<td colspan="2">Drive configuration</td>
<td colspan="2" align="center">Mid-mounted front-engine / rear-wheel drive</td>
</tr>
<tr>
<td width="101" valign="top">
<p>Transmission type</p>
</td>
<td width="260" style="text-align: right;"><br /><span align="right">6-speed close-ratio manual w/EXEDY high-performance clutch<br />9-speed auto w/drive mode switch,<br />shift by wire Paddle shifters (9AT)<br />Unique paddle shifters (9AT)<br />Launch control</span></td>
<td align="center" style="text-align: center;"><br />S<br /><br />O<br />S<br />-<br />-</td>
<td align="center" style="text-align: center;"><br />S <br /><br />O<br />-<br />S<br />S</td>
</tr>
