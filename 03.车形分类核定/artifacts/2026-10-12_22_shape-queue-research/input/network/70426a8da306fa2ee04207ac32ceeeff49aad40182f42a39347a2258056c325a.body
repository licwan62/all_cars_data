<td colspan="8" align="center"><strong>Sport</strong></td>
<td colspan="4" align="center"><strong>Performance</strong></td>
</tr>
<tr>
<td colspan="8">Wheelbase</td>
<td colspan="12" align="center">100.4</td>
</tr>
<tr>
<td colspan="8">Overall length</td>
<td colspan="12" align="center">172.4</td>
</tr>
<tr>
<td colspan="8">Overall width</td>
<td colspan="12" align="center">72.6</td>
</tr>
<tr>
<td colspan="8">Overall height</td>
<td colspan="12" align="center">51.8</td>
</tr>
<tr>
<td colspan="8">Ground clearance</td>
<td colspan="12" align="center">4.8</td>
</tr>
<tr>
<td colspan="3">Track</td>
<td colspan="5">Front <br />Rear</td>
<td colspan="8" align="center">61.6<br />62.8</td>
<td colspan="4" align="center">61.2<br />61.6</td>
</tr>
</tbody>
</table>
<p>&nbsp;</p>
<table class="table" border="1">
<tbody>
<tr>
