<td colspan="12" align="center">54.6</td>
</tr>
<tr>
<td colspan="8">Shoulder room</td>
<td colspan="12" align="center">54.2</td>
</tr>
</tbody>
</table>
<p><strong>Weight</strong></p>
<table class="table" border="1">
<tbody>
<tr>
