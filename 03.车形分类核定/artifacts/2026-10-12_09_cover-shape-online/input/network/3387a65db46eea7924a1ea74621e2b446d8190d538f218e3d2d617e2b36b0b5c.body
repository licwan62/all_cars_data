<script>
document.addEventListener('facetwp-refresh', function() {
    // Show loader
    jQuery('.facetwp-template').append('<div class="fwp-loading-overlay"></div>');
    jQuery('.fwp-loading-overlay').show();
});

document.addEventListener('facetwp-loaded', function() {
    // Remove loader
    jQuery('.fwp-loading-overlay').remove();
});
</script>

