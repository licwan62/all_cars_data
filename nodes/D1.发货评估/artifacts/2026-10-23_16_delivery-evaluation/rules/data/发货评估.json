{
  "schema_version": 1,
  "status": "active",
  "region": "US",
  "market_potential": {
    "evaluation_year": 2026,
    "full_weight_years": 5,
    "half_life_years": 10
  },
  "classification": {
    "w_size_prefix": "4",
    "pickup_category": "皮卡"
  },
  "gray_match": {
    "enabled": true,
    "identity_keys": ["评估类别", "MAKE", "MODEL", "版本", "结构", "CAB", "BED"],
    "max_year_gap": 1,
    "boundary_band_mm": 25,
    "max_group_spread_mm": {
      "length": 50,
      "width": 50,
      "height": 50
    },
    "adjacent_sizes_only": true,
    "target_strategy": "larger",
    "target_length_margin_mm": {
      "min": 50,
      "max_exclusive": 500
    }
  },
  "review_inference": {
    "enabled": true,
    "key_fields": ["MODEL", "L-MM", "W-MM", "H-MM"],
    "seed_match_methods": ["精确匹配"],
    "protected_match_methods": ["精确匹配"],
    "target_match_method": "推理匹配"
  },
  "sku": {
    "group_keys": ["MAKE", "MODEL", "供货尺码"],
    "max_year_gap": 1,
    "natural_key": ["MAKE", "MODEL", "YEAR", "供货尺码"]
  },
  "output_schema": {
    "merge_review_fields_into_notes": {
      "差评模糊原因": "模糊原因",
      "差评推理原因": "推理原因",
      "差评推理键": "推理键",
      "差评推理来源": "推理来源"
    },
    "drop_from_business_outputs": ["DIMENSION-ID", "DIMENSION-ID数量"],
    "drop_from_nonpickup_category_outputs": ["CAB", "BED"],
    "blank_in_nonpickup_detail": ["CAB", "BED"],
    "drop_from_gray_audit": ["源DIMENSION-ID"]
  },
  "scope_note": "覆盖 A0 US 全量表全部 DIMENSION-ID，但业务交付以 SKU 为主键：MAKE+MODEL+连续YEAR年份区间+供货尺码；版本、结构、CAB、BED仅作汇总核对字段，不参与拆分SKU。W型车按自动尺码以4开头识别；剩余皮卡按分类=皮卡识别；其余为普通车。市场潜力只用于相对排序，不计算发货量。差评只有品牌车型、结构、年代和尺码均可核实时标记精确匹配，否则先标记模糊匹配；再以全量表 MODEL+L-MM+W-MM+H-MM 为键，把精确匹配记录的差评传播到非精确命中的相同尺寸记录，并标记推理匹配。"
}
