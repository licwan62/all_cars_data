,"source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"application/pdf"}]},"23408377":{"pageid":23408377,"ns":6,"title":"File:Ford B0159 NLGRF photo contact sheet (1976-06-09)(Gerald Ford Library).jpg","index":6,"imagerepository":"local","imageinfo":[{"size":3148459,"width":1674,"height":2184,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg/960px-Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":1252,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/d/de/Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg/960px-Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":1252,"srcset":"https://upload.wikimedia.org/wikipedia/commons/d/de/Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/d/de/Ford_B0159_NLGRF_photo_contact_sheet_%281976-06-09%29%28Gerald_Ford_Library%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ford_B0159_NLGRF_photo_contact_sheet_(1976-06-09)(Gerald_Ford_Library).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=23408377","extmetadata":{"DateTime":{"value":"2012-12-29 17:56:05","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Ford B0159 NLGRF photo contact sheet (1976-06-09)(Gerald Ford Library)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US Government|David Gergen|Presidents of the United States involved in Scouting|Media contributed by the Gerald R. Ford Presidential Library and Museum|CC-PD-Mark|Contact sheets by the Ford White House (June 1976)|Photographs by William Fitz-Patrick|Dick Thornburgh in 1976|Brent Scowcroft in 1976","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The photo contact sheet, identified as <b>B0159</b> by the <a href=\"https://en.wikipedia.org/wiki/White_House_Photographic_Office\" class=\"extiw\" title=\"w:White House Photographic Office\">White House Photographic Office</a> (WHPO), is housed at the <a href=\"https://en.wikipedia.org/wiki/Gerald_R._Ford_Presidential_Library\" class=\"extiw\" title=\"w:Gerald R. Ford Presidential Library\">Gerald R. Ford Presidential Library</a>, a branch of the <a href=\"https://en.wikipedia.org/wiki/National_Archives_and_Records_Administration\" class=\"extiw\" title=\"w:National Archives and Records Administration\">National Archives and Records Administration (NARA)</a>.<br><br>\n<p>This file is a 200 <a href=\"https://en.wikipedia.org/wiki/Dots_per_inch\" class=\"extiw\" title=\"w:Dots per inch\">dpi</a> <a href=\"https://en.wikipedia.org/wiki/Contact_print#Proof_sheets\" class=\"extiw\" title=\"w:Contact print\">photo contact sheet</a> having images from <a href=\"https://en.wikipedia.org/wiki/roll_film\" class=\"extiw\" title=\"w:roll film\">roll of film</a> B0159 of the <i>August 9, 1974 - January 20, 1977 <a href=\"https://en.wikipedia.org/wiki/Gerald_R._Ford\" class=\"extiw\" title=\"w:Gerald R. Ford\">Gerald R. Ford</a> White House Photographic Office Series A0001-A9999 and B0001-B2886 photographs.</i> <br><br>\n</p>\nThe date on the photo contact sheet is the date the roll of film was processed, not necessarily the date the photographs were taken. See <a href=\"#Table\">table</a> below for additional details.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1976-06-09","source":"commons-desc-page"},"Credit":{"value":"<a href=\"https://en.wikipedia.org/wiki/Gerald_R._Ford_Presidential_Library\" class=\"extiw\" title=\"w:Gerald R. Ford Presidential Library\">Gerald R. Ford Presidential Library</a>, Image: <a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"http://www.fordlibrarymuseum.gov/library/whphotos/B0159_NLGRF.jpg\" href=\"https://www.fordlibrarymuseum.gov/library/whphotos/B0159_NLGRF.jpg\">B0159_NLGRF.jpg</a> from <a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"http://www.fordlibrarymuseum.gov/library/whphotos/19760609whpo.pdf\" href=\"https://www.fordlibrarymuseum.gov/library/whphotos/19760609whpo.pdf\">White House Photographs, June 9, 1976</a> of the <a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"http://www.fordlibrarymuseum.gov/Library/whphotos/whpo.asp\" href=\"https://www.fordlibrarymuseum.gov/Library/whphotos/whpo.asp\">White House Photographic Collection page</a>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"https://en.wikipedia.org/wiki/White_House_Photographic_Office\" class=\"extiw\" title=\"w:White House Photographic Office\">White House Photographic Office</a> (WHPO) - Fitz-Patrick","source":"commons-desc-page"},"Permission":{"value":"This work is in the <b><a href=\"https://en.wikipedia.org/wiki/en:Public_domain\" class=\"extiw\" title=\"w:en:Public domain\">public domain</a></b> in the United States because it is a <a href=\"https://en.wikipedia.org/wiki/en:Copyright_status_of_work_by_the_U.S._government\" class=\"extiw\" title=\"w:en:Copyright status o