{"continue":{"clcontinue":"98492287|Books_uploaded_by_F\u00e6","continue":"||imageinfo"},"query":{"pages":{"40645616":{"pageid":40645616,"ns":6,"title":"File:1974 Ford Mustang Ghia (14389802775).jpg","index":4,"imagerepository":"local","imageinfo":[{"size":3934306,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/1974_Ford_Mustang_Ghia_%2814389802775%29.jpg/960px-1974_Ford_Mustang_Ghia_%2814389802775%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/1974_Ford_Mustang_Ghia_%2814389802775%29.jpg/1920px-1974_Ford_Mustang_Ghia_%2814389802775%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/1974_Ford_Mustang_Ghia_%2814389802775%29.jpg/960px-1974_Ford_Mustang_Ghia_%2814389802775%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/1974_Ford_Mustang_Ghia_%2814389802775%29.jpg/1920px-1974_Ford_Mustang_Ghia_%2814389802775%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8c/1974_Ford_Mustang_Ghia_%2814389802775%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1974_Ford_Mustang_Ghia_(14389802775).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=40645616","extmetadata":{"DateTime":{"value":"2015-06-01 01:50:33","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1974 Ford Mustang Ghia (14389802775)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"1974 Ford Mustang|Images with extracted images|Flickr images reviewed by FlickreviewR|Red Ford coupes|Files with coordinates missing SDC location of creation|United States photographs taken on 2014-04-19|1970s red coupes|Photographs by Sicnag","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"35.351940","source":"commons-desc-page"},"GPSLongitude":{"value":"-80.682220","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Bright Red. \nThe 1974-78 2nd generation Mustang followed world trends influenced by the oil crisis etc and was a smaller car again. In 1974, only available with a 140 cu in 4 cyl or 171 cu in V6. The engine bay was modified and the V8 brought back in 1975, as the oil crisis started to ease. In 1974, the Mustang II packages ranged from the base Hardtop, 2+2 hatchback, a Ghia luxury group with vinyl roof, and a top of the line V6-powered Mach 1\n</p>\nPhotographed at the 50th Anniversary of the Mustang celebrations at the Charlotte Motor Speedway, April 2014","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-04-19 07:01","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/14389802775/\">1974 Ford Mustang Ghia</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:1970s red coupes"},{"ns":14,"title":"Category:1974 Ford Mustang"},{"ns":14,"title":"Category:CC-BY-2.0"},{"ns":14,"title":"Category:Files with coordinates missing SDC location of creation"},{"ns":14,"title":"Category:Flickr images reviewed by FlickreviewR"},{"ns":14,"title":"Category:Images with extracted images"},{"ns":14,"title":"Category:Photographs by Sicnag"},{"ns":14,"title":"Category:Red Ford coupes"},{"ns":14,"title":"Category:United States photographs taken on 2014-04-19"}]},"143388195":{"pageid":143388195,"ns":6,"title":"File:1974 Ford Mustang Ghia (14389802775) (cropped).jpg","index":3,"imagerepository":"local","imageinfo":[{"size":2885067,"width":4347,"height":2900,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg/960px-1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg/1920px-1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg/960px-1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg/1920px-1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/72/1974_Ford_Mustang_Ghia_%2814389802775%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1974_Ford_Mustang_Ghia_(14389802775)_(cropped).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=143388195","extmetadata":{"DateTime":{"value":"2024-01-01 23:27:39","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1974 Ford Mustang Ghia (14389802775) (cropped)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"1974 Ford Mustang|Extracted images|Red Ford coupes|Files with coordinates missing SDC location of creation|United States photographs taken on 2014-04-19|1970s red coupes|Photographs by Sicnag","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"35.351940","source":"commons-desc-page"},"GPSLongitude":{"value":"-80.682220","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Bright Red. \nThe 1974-78 2nd generation Mustang followed world trends influenced by the oil crisis etc and was a smaller car again. In 1974, only available with a 140 cu in 4 cyl or 171 cu in V6. The engine bay was modified and the V8 brought back in 1975, as the oil crisis started to ease. In 1974, the Mustang II packages ranged from the base Hardtop, 2+2 hatchback, a Ghia luxury group with vinyl roof, and a top of the line V6-powered Mach 1\n</p>\nPhotographed at the 50th Anniversary of the Mustang celebrations at the Charlotte Motor Speedway, April 2014","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-04-19 07:01","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/14389802775/\">1974 Ford Mustang Ghia</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},"81848895":{"pageid":81848895,"ns":6,"title":"File:1975 Ford Capri Mk II JPS (46254000324).jpg","index":5,"imagerepository":"local","imageinfo":[{"size":5754619,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg/960px-1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg/1920px-1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg/960px-1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg/1920px-1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/19/1975_Ford_Capri_Mk_II_JPS_%2846254000324%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1975_Ford_Capri_Mk_II_JPS_(46254000324).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=81848895","extmetadata":{"DateTime":{"value":"2019-09-03 17:49:40","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1975 Ford Capri Mk II JPS (46254000324)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Ford Capri II|Files with coordinates missing SDC location of creation|Flickr images reviewed by FlickreviewR 2|Australia photographs taken on 2019-02-03|Photographs by Sicnag","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"-37.849029","source":"commons-desc-page"},"GPSLongitude":{"value":"144.981594","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>While Ford America called the Mustang its Pony car, Ford of Europe's Pony car was the Capri. The Capri got the same long hood, short deck styling, but no V8 of course. The European Ford Capri was built from 1968-86 Through three generations;\nThe 1968-74 Mk I Capri, a facelift in 1972\nThis, the 1974-78 Mk II Capri was assembled in 3 countries; UK, Belgium and Germany. Ford chose to make the new car more suited to everyday driving, with a shorter bonnet, larger cabin and the adoption of a hatchback rear door. By the standards of the day the Mk II was a very well evolved vehicle with very few reliability issues. Although it was mechanically similar to the Mk I, the Mk II had a revised larger body and a more modern dashboard including a smaller steering wheel. The 2.0 L version of the Pinto was introduced in the European model, and was placed below the 3.0L V6, although it was more powerful. The Capri still maintained the large square headlights, which became the easiest way to distinguish between a Mk II and a Mk III.\nEngines; 1.3, 1.6, 1.6 GT and 2.0 litre 4 cyl. \n2.3 V6 in Germany or 3.0 V6 in England\nThe John Player Special limited edition (JPS) was produced in March 1975, available in black or white, featuring gold pinstriping to mimic the Formula 1 livery, gold-coloured wheels, and a bespoke upgraded interior of beige cloth and carpet trimmed with black.\nIn 1976, the 3.0 GT was replaced by either the 3.0 S or 3.0 Ghia\n</p>\nThe 1978-86 Mk III Capri got the quad round headlight front.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-02-03 09:55","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/46254000324/\">1975 Ford Capri Mk II JPS</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:Australia photographs taken on 2019-02-03"},{"ns":14,"title":"Category:CC-BY-2.0"},{"ns":14,"title":"Category:Files with coordinates missing SDC location of creation"},{"ns":14,"title":"Category:Flickr images reviewed by FlickreviewR 2"},{"ns":14,"title":"Category:Ford Capri II"},{"ns":14,"title":"Category:Photographs by Sicnag"}]},"64094575":{"pageid":64094575,"ns":6,"title":"File:1978 Ford Mustang II King Cobra Hatchback (30237716893).jpg","index":1,"imagerepository":"local","imageinfo":[{"size":5403250,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg/960px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg/1920px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg/960px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg/1920px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/e/e1/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1978_Ford_Mustang_II_King_Cobra_Hatchback_(30237716893).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=64094575","extmetadata":{"DateTime":{"value":"2017-11-15 22:54:57","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1978 Ford Mustang II King Cobra Hatchback (30237716893)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Images with extracted images|Files with coordinates missing SDC location of creation|Flickr images reviewed by FlickreviewR 2|Australia photographs taken on 2016-10-30|Photographs by Sicnag|Ford Mustang II King Cobra","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"-38.039844","source":"commons-desc-page"},"GPSLongitude":{"value":"145.364398","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Bright Red. \nFords Pony car, the Mustang was first introduced in April, 1964.\nWith the 1974-78 second generation, Lee Iacocca wanted to bring the Mustang back to a small, sporty, luxurious, personal car to follow the world trend. The Mustang II, the first Mustang to be offered with a 4 cyl. (used until 1993)\nSimulating the earlier Shelbys, the Cobra II appearance package was introduced in 1976 with simulated hood scoop, front and rear spoilers and cobra-themed graphics. Note, hood scoops went from facing forward in 76 to facing rearward in 77. The King Cobra, (4313 made) got a cobra snake decal on the hood was available in 1978.\nThe T top was an option in 1977 on only the Hatchback\nTwo body styles were available, the 2 door Hardtop Coupe with woodgrain instrument panel and the 3 door Hatchback with brushed aluminium instrument panel. \nThe Coupe available in Standard or the luxury Ghia, the Ghia, from 1975, with opera windows and vinyl roof.\nThe Hatchback available in Standard or the V6 Mach 1. The sporty Mach got dual tail pipes, and a Tu-Tone paint job, black on the lower body and rear taillight panel.\n</p>\nEngines; 88hp 140 cu in 4 cyl, 105hp 171 cu in V6 and 134hp 302 V8","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-10-30 10:07","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/30237716893/\">1978 Ford Mustang II King Cobra Hatchback</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:Australia photographs taken on 2016-10-30"},{"ns":14,"title":"Category:CC-BY-2.0"},{"ns":14,"title":"Category:Files with coordinates missing SDC location of creation"},{"ns":14,"title":"Category:Flickr images reviewed by FlickreviewR 2"},{"ns":14,"title":"Category:Ford Mustang II King Cobra"},{"ns":14,"title":"Category:Images with extracted images"},{"ns":14,"title":"Category:Photographs by Sicnag"}]},"143388403":{"pageid":143388403,"ns":6,"title":"File:1978 Ford Mustang II King Cobra Hatchback (30237716893) (cropped).jpg","index":2,"imagerepository":"local","imageinfo":[{"size":3550521,"width":4257,"height":2840,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg/960px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg/1920px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg/960px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg/1920px-1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/12/1978_Ford_Mustang_II_King_Cobra_Hatchback_%2830237716893%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1978_Ford_Mustang_II_King_Cobra_Hatchback_(30237716893)_(cropped).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=143388403","extmetadata":{"DateTime":{"value":"2024-01-01 23:36:07","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1978 Ford Mustang II King Cobra Hatchback (30237716893) (cropped)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Extracted images|Files with coordinates missing SDC location of creation|Australia photographs taken on 2016-10-30|Photographs by Sicnag|Ford Mustang II King Cobra","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"-38.039844","source":"commons-desc-page"},"GPSLongitude":{"value":"145.364398","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Bright Red. \nFords Pony car, the Mustang was first introduced in April, 1964.\nWith the 1974-78 second generation, Lee Iacocca wanted to bring the Mustang back to a small, sporty, luxurious, personal car to follow the world trend. The Mustang II, the first Mustang to be offered with a 4 cyl. (used until 1993)\nSimulating the earlier Shelbys, the Cobra II appearance package was introduced in 1976 with simulated hood scoop, front and rear spoilers and cobra-themed graphics. Note, hood scoops went from facing forward in 76 to facing rearward in 77. The King Cobra, (4313 made) got a cobra snake decal on the hood was available in 1978.\nThe T top was an option in 1977 on only the Hatchback\nTwo body styles were available, the 2 door Hardtop Coupe with woodgrain instrument panel and the 3 door Hatchback with brushed aluminium instrument panel. \nThe Coupe available in Standard or the luxury Ghia, the Ghia, from 1975, with opera windows and vinyl roof.\nThe Hatchback available in Standard or the V6 Mach 1. The sporty Mach got dual tail pipes, and a Tu-Tone paint job, black on the lower body and rear taillight panel.\n</p>\nEngines; 88hp 140 cu in 4 cyl, 105hp 171 cu in V6 and 134hp 302 V8","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-10-30 10:07","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/30237716893/\">1978 Ford Mustang II King Cobra Hatchback</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},"91597709":{"pageid":91597709,"ns":6,"title":"File:Automotive marketing methods and practice - final report (IA automotivemarket00brad).pdf","index":8,"imagerepository":"local","imageinfo":[{"size":9645737,"width":1139,"height":1545,"pagecount":194,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Automotive_marketing_methods_and_practice_-_final_report_%28IA_automotivemarket00brad%29.pdf/page1-960px-Automotive_marketing_methods_and_practice_-_final_report_%28IA_automotivemarket00brad%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":1302,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Automotive_marketing_methods_and_practice_-_final_report_%28IA_automotivemarket00brad%29.pdf/page1-960px-Automotive_marketing_methods_and_practice_-_final_report_%28IA_automotivemarket00brad%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","wi