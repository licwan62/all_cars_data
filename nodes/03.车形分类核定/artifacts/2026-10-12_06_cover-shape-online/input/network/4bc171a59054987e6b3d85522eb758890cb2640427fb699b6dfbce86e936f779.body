wiki-metadata","hidden":""},"ObjectName":{"value":"1974 Ford Mustang II Funny Car \"Shirl Greer\" - 30252295952","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"1974 Ford Mustang|Flickr images missing SDC creator|Flickr images missing SDC source of file|Files with coordinates missing SDC location of creation|Flickr images reviewed by FlickreviewR 2|Lake Mirror Classic Auto Fest|Ford Mustang II in competition","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"28.042971","source":"commons-desc-page"},"GPSLongitude":{"value":"-81.950737","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"Frances Langford Promenade, Lakeland","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-10-15 11:38:18","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.flickr.com/photos/119886413@N05/30252295952/\">https://www.flickr.com/photos/119886413@N05/30252295952/</a>","source":"commons-desc-page"},"Artist":{"value":"Michel Curi","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}]},"40645824":{"pageid":40645824,"ns":6,"title":"File:1974 Ford XB Fairmont GS Hardtop (13577337215).jpg","index":7,"imagerepository":"local","imageinfo":[{"size":4541766,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg/960px-1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg/1920px-1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg/960px-1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg/1920px-1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/83/1974_Ford_XB_Fairmont_GS_Hardtop_%2813577337215%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1974_Ford_XB_Fairmont_GS_Hardtop_(13577337215).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=40645824","extmetadata":{"DateTime":{"value":"2015-06-01 01:54:18","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1974 Ford XB Fairmont GS Hardtop (13577337215)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images reviewed by FlickreviewR|Ford Fairmont (XB)|Files with coordinates missing SDC location of creation|Australia photographs taken on 2014-03-23|Photographs by Sicnag","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"-37.908788","source":"commons-desc-page"},"GPSLongitude":{"value":"145.223636","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Red Pepper. \nThe XB Falcon was built from Sept 1973- July 1976.  \nThe XA got a facelift in 1973; the XB was introduced, it got a more pronounced nose due to the reworking of the bonnet. It also got a divided honeycombgrille, more conventional  taillights and new bumpers. The Falcon now with 4 wheel disc brakes. The GS and GT bonnet got new hood scoops, the design reminiscent of the 1971-73 U.S. Mustang\nEngines; 250 6 or 302 and 351 V8s (now all locally built). \nSedan; Standard, 500, Fairmont and GT\nHardtop: 500, Fairmont, GT and limited John Goss Special\nWagon; Standard, 500 and Fairmont\nAlso Utility and Panel Van in Standard and 500\nThe GS package was available on 500, Futura or Fairmont, \n</p>\nThe GS came with GS stripes (similar to XW GT), GT bonnet with twin scoops, 12 slot rims, GT full instrumentation, and rim blow steering wheel","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-03-23 11:29","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/13577337215/\">1974 Ford XB Fairmont GS Hardtop</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:Australia photographs taken on 2014-03-23"},{"ns":14,"title":"Category:CC-BY-2.0"},{"ns":14,"title":"Category:Files with coordinates missing SDC location of creation"},{"ns":14,"title":"Category:Flickr images reviewed by FlickreviewR"},{"ns":14,"title":"Category:Ford Fairmont (XB)"},{"ns":14,"title":"Category:Photographs by Sicnag"}]},"46872605":{"pageid":46872605,"ns":6,"title":"File:1974 Ford XB Falcon GT Sedan (22348583760).jpg","index":5,"imagerepository":"local","imageinfo":[{"size":4424174,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg/960px-1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg/1920px-1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg/960px-1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg/1920px-1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1a/1974_Ford_XB_Falcon_GT_Sedan_%2822348583760%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1974_Ford_XB_Falcon_GT_Sedan_(22348583760).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=46872605","extmetadata":{"DateTime":{"value":"2016-02-09 04:28:07","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1974 Ford XB Falcon GT Sedan (22348583760)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images reviewed by FlickreviewR|Files with coordinates missing SDC location of creation|Australia photographs taken on 2015-10-25|Ford Falcon GT (XB)|Photographs by Sicnag|Flickr images missing SDC Flickr photo ID|Flickr images missing SDC published in","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"-38.117437","source":"commons-desc-page"},"GPSLongitude":{"value":"145.271100","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Mulberry. \nThe XB Falcon was built from Sept 1973- July 1976.  \nThe XA got a facelift in 1973; the XB was introduced, it got a more pronounced nose due to the reworking of the bonnet. It also got a divided honeycomb grille, more conventional  taillights and new bumpers. The GT got new hood scoops, the design reminiscent of the 1971-73 U.S. Mustang, the GT badges were gone and replaced by GT351 decals on the guards and boot. \nOnly a handful of early manual XB GTs had the imported 4V Cleveland that earlier GTs had, the rest were Australian built 2V engines which took either a 2 or 4 barrel carb. Along with new emission controls, meant the XB was not as fast as earlier GTs, but it did get 4 wheel disc brakes, now standard. The XB GT was a more refined tourer, rather than a road going race car.\nEngine; 351 Cleveland\n</p>\n1950 XB GT Sedans and 949 XB GT Hardtops were made, 111 Sedans in Mulberry","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2015-10-25 12:59","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/22348583760/\">1974 Ford XB Falcon GT Sedan</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:Australia photographs taken on 2015-10-25"},{"ns":14,"title":"Category:CC-BY-2.0"},{"ns":14,"title":"Category:Files with coordinates missing SDC location of creation"},{"ns":14,"title":"Category:Flickr images missing SDC Flickr photo ID"},{"ns":14,"title":"Category:Flickr images missing SDC published in"},{"ns":14,"title":"Category:Flickr images reviewed by FlickreviewR"},{"ns":14,"title":"Category:Ford Falcon GT (XB)"},{"ns":14,"title":"Category:Photographs by Sicnag"}]},"64093752":{"pageid":64093752,"ns":6,"title":"File:1974 Ford XB Falcon GT Sedan (23654565108).jpg","index":12,"imagerepository":"local","imageinfo":[{"size":5100893,"width":5184,"height":3456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg/960px-1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":640,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg/1920px-1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg/960px-1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":640,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg/1920px-1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/9/94/1974_Ford_XB_Falcon_GT_Sedan_%2823654565108%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1974_Ford_XB_Falcon_GT_Sedan_(23654565108).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=64093752","extmetadata":{"DateTime":{"value":"2017-11-15 22:31:10","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1974 Ford XB Falcon GT Sedan (23654565108)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Files with coordinates missing SDC location of creation|Australia photographs taken on 2017-09-24|Flickr images reviewed by FlickreviewR 2|Ford Falcon GT (XB)|Photographs by Sicnag","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"-34.819391","source":"commons-desc-page"},"GPSLongitude":{"value":"138.954595","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Corporate Blue. \nThe XB Falcon was built from Sept 1973- July 1976.  \nThe XA got a facelift in 1973; the XB was introduced, it got a more pronounced nose due to the reworking of the bonnet. It also got a divided honeycomb grille, more conventional  taillights and new bumpers. The GT got new hood scoops, the design reminiscent of the 1971-73 U.S. Mustang, the GT badges were gone and replaced by GT351 decals on the guards and boot. \nOnly a handful of early manual XB GTs had the imported 4V Cleveland that earlier GTs had, the rest were Australian built 2V engines which took either a 2 or 4 barrel carb. Along with new emission controls, meant the XB was not as fast as earlier GTs, but it did get 4 wheel disc brakes, now standard. The XB GT was a more refined tourer, rather than a road going race car.\nEngine; 300hp 351 cu in Cleveland\n</p>\n1950 XB GT Sedans and 949 XB GT Hardtops were made, 3 Sedans in Corporate Blue","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2017-09-24 13:12","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/23654565108/\">1974 Ford XB Falcon GT Sedan</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:Australia photographs taken on 2017-09-24"}]},"142100927":{"pageid":142100927,"ns":6,"title":"File:1974 Pontiac Firebird Interior.jpg","index":9,"imagerepository":"local","imageinfo":[{"size":5426317,"width":4128,"height":2322,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/1974_Pontiac_Firebird_Interior.jpg/960px-1974_Pontiac_Firebird_Interior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":540,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/1974_Pontiac_Firebird_Interior.jpg/1920px-1974_Pontiac_Firebird_Interior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/1974_Pontiac_Firebird_Interior.jpg/960px-1974_Pontiac_Firebird_Interior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":540,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/1974_Pontiac_Firebird_Interior.jpg/1920px-1974_Pontiac_Firebird_Interior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/c3/1974_Pontiac_Firebird_Interior.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:1974_Pontiac_Firebird_Interior.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=142100927","extmetadata":{"DateTime":{"value":"2023-12-13 02:13:56","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1974 Pontiac Firebird Interior","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images missing SDC inception|Files with coordinates missing SDC location of creation|Flickr images reviewed by FlickreviewR 2|1974 Pontiac Firebird|Pontiac interiors","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"37.817436","source":"commons-desc-page"},"GPSLongitude":{"value":"-96.850464","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"From Wikipedia:\n<p>en.wikipedia.org/wiki/Pontiac_Firebird\n</p><p>The Pontiac Firebird is an American automobile that was built and produced by Pontiac from the 1967 to 2002 model years. Designed as a pony car to compete with the Ford Mustang, it was introduced on February 23, 1967, simultaneous with GM's Chevrolet division platform-sharing Camaro. This also coincided with the release of the 1967 Mercury Cougar, Ford's upscale, platform-sharing version of the Mustang.\n</p><p>2nd Generation:\n</p><p>Replacing the \"Coke bottle\" styling was a more \"swoopy\" body style, while still retaining some traditional elements. The top of the rear window line going almost straight down to the lip of the trunk lid, a look that was to epitomize F-body styling for the longest period during the Firebird's lifetime.\n</p><p>Eldorado, Kansas Car Show, Sep 2014\n</p>\nPhoto by Eric Friedebach","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-09-20 12:30:44","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.flickr.com/photos/friedebach/50867795406/\">https://www.flickr.com/photos/friedebach/50867795406/</a>","source":"commons-desc-page"},"Artist":{"value":