iptionurl":"https://commons.wikimedia.org/wiki/File:1993_Ford_Mustang_Saleen_SC_Convertible_(14228540957).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=40645589","extmetadata":{"DateTime":{"value":"2015-06-01 01:49:56","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"1993 Ford Mustang Saleen SC Convertible (14228540957)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Flickr images reviewed by FlickreviewR|Saleen Mustang|1993 Ford automobiles|Files with coordinates missing SDC location of creation|United States photographs taken on 2014-04-18|Photographs by Sicnag|Ford Mustang Convertible (1987-1993)","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"35.351940","source":"commons-desc-page"},"GPSLongitude":{"value":"-80.682220","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>Canary Yellow. \nThe 3rd generation Fox body Mustang was made from 1979-1993, a minor update to front and rear in 1983, and again in 1985, then a more substantial update in 1987 saw the grille and quad headlights replaced by modern single headlights and the no grille aero look.\nOnly models available were the LX and GT and just the 2.3 litre 4 and 5.0 V8, still coupe, hatchback and convertible. \nSaleen manufactured limited edition, high-performance Mustangs. The SC was produced from 1990 to 93. Only 3 hatchbacks and 2 convertibles in 1993. They got the Vortech Supercharger making 291 hp.\n</p>\nPhotographed at the 50th Anniversary of the Mustang celebrations at the Charlotte Motor Speedway, April 2014","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-04-18 05:37","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/42220226@N07/14228540957/\">1993 Ford Mustang Saleen SC Convertible</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/42220226@N07\">Sicnag</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}},"mime":"image/jpeg"}],"categories":[{"ns":14,"title":"Category:1993 Ford automobiles"},{"ns":14,"title":"Category:CC-BY-2.0"},{"ns":14,"title":"Category:Files with coordinates missing SDC location of creation"},{"ns":14,"title":"Category:Flickr images reviewed by FlickreviewR"},{"ns":14,"title":"Category:Ford Mustang Convertible (1987-1993)"},{"ns":14,"title":"Category:Photographs by Sicnag"},{"ns":14,"title":"Category:Saleen Mustang"},{"ns":14,"title":"Category:United States photographs taken on 2014-04-18"}]},"153103350":{"pageid":153103350,"ns":6,"title":"File:Advances in hydrologic engineering - USACE-p16021coll8-2930.pdf","index":7,"imagerepository":"local","imageinfo":[{"size":1961120,"width":1275,"height":1650,"pagecount":13,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Advances_in_hydrologic_engineering_-_USACE-p16021coll8-2930.pdf/page1-960px-Advances_in_hydrologic_engineering_-_USACE-p16021coll8-2930.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":1242,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Advances_in_hydrologic