nRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"application/pdf"}],"categories":[{"ns":14,"title":"Category:Books uploaded by F\u00e6"},{"ns":14,"title":"Category:Books without Wikidata item"},{"ns":14,"title":"Category:CC-PD-Mark"},{"ns":14,"title":"Category:IA uploads needing categories"},{"ns":14,"title":"Category:PD-old-100-expired"},{"ns":14,"title":"Category:PD-old missing SDC copyright status"},{"ns":14,"title":"Category:Scans from University of Toronto"},{"ns":14,"title":"Category:Scans from the Internet Archive"},{"ns":14,"title":"Category:Scans from the Internet Archive/unverified"}]},"193443666":{"pageid":193443666,"ns":6,"title":"File:Franklin (Ship) of New Bedford, Mass. and Heroine (Ship) of Fairhaven, Mass., mastered by David G. Chadwick and David P. West, keeper unknown, on voyage 21 April 1843 - 20 September 1845 (IA KWM-785).pdf","index":2,"imagerepository":"local","imageinfo":[{"size":32167975,"width":1283,"height":2008,"pagecount":94,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Franklin_%28Ship%29_of_New_Bedford%2C_Mass._and_Heroine_%28Ship%29_of_Fairhaven%2C_Mass.%2C_mastered_by_David_G._Chadwick_and_David_P._West%2C_keeper_unknown%2C_on_voyage_21_April_1843_-_20_September_1845_%28IA_KWM-785%29.pdf/page1-960px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":960,"thumbheight":1502,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Franklin_%28Ship%29_of_New_Bedford%2C_Mass._and_Heroine_%28Ship%29_of_Fairhaven%2C_Mass.%2C_mastered_by_David_G._Chadwick_and_David_P._West%2C_keeper_unknown%2C_on_voyage_21_April_1843_-_20_September_1845_%28IA_KWM-785%29.pdf/page1-1280px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Franklin_%28Ship%29_of_New_Bedford%2C_Mass._and_Heroine_%28Ship%29_of_Fairhaven%2C_Mass.%2C_mastered_by_David_G._Chadwick_and_David_P._West%2C_keeper_unknown%2C_on_voyage_21_April_1843_-_20_September_1845_%28IA_KWM-785%29.pdf/page1-960px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":960,"height":1502,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Franklin_%28Ship%29_of_New_Bedford%2C_Mass._and_Heroine_%28Ship%29_of_Fairhaven%2C_Mass.%2C_mastered_by_David_G._Chadwick_and_David_P._West%2C_keeper_unknown%2C_on_voyage_21_April_1843_-_20_September_1845_%28IA_KWM-785%29.pdf/page1-1280px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8d/Franklin_%28Ship%29_of_New_Bedford%2C_Mass._and_Heroine_%28Ship%29_of_Fairhaven%2C_Mass.%2C_mastered_by_David_G._Chadwick_and_David_P._West%2C_keeper_unknown%2C_on_voyage_21_April_1843_-_20_September_1845_%28IA_KWM-785%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Franklin_(Ship)_of_New_Bedford,_Mass._and_Heroine_(Ship)_of_Fairhaven,_Mass.,_mastered_by_David_G._Chadwick_and_David_P._West,_keeper_unknown,_on_voyage_21_April_1843_-_20_September_1845_(IA_KWM-785).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=193443666","extmetadata":{"DateTime":{"value":"2026-06-06 05:57:00","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\nFranklin (Ship) of New Bedford, Mass. and Heroine (Ship) of Fairhaven, Mass., mastered by David G. Chadwick and David P. West, keeper unknown, on voyage 21 April 1843 - 20 September 1845</div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD-old-100-expired|Scans from the Internet Archive/unverified|CC-PD-Mark|Scans from the Internet Archive|Books uploaded by F\u00e6|Books without Wikidata item|Old books from American Libraries|PD-old missing SDC copyright status","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<div class=\"fn value\">\n<dl><dd>Franklin (Ship)</dd>\n<dd>Chadwick, David Gifford</dd>\n<dd>Heroine (Ship)</dd>\n<dd>West, David P.</dd></dl></div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n<p>Logbook , keeper unknown, of outgoing and homeward voyages. Outgoing voyage documents the Franklin (Ship) of New Bedford, Mass., mastered by David G. Chadwick, from 21 April 1843 - 20 September 1845 in Indian Ocean  and South Pacific Ocean.Includes whale stamps and a description of Captain Borden of the Sally Ann of New Bedford having both of his legs broken by a sperm whale. Homeward voyage documents the Heroine (Ship) of Fairhaven, Mass., mastered by David P. West, from 14 June 1843 - 24 February 1845. Since the ship was heading homeward there is very little happening during the voyage. There was a man overboard.\n</p>\n<br>Subjects: Whaling--Massachuetts--New Bedford; Whaling--Massachuetts--Fairhaven; Chadwick, David G; Howland, A. H.--(Abraham H.); Borden, Robert E.,--1808-1860; Ontario (Ship:1820-1853)--Sightings and encounters; Sally Ann (Ship)--Sightings and encounters; Albion (Ship)--Sightings and encounters; Heroine (Ship)--Sightings and encounters; Finback whale; Blue whale; Sperm whale; Accidents; Whalers (Persons)--Wounds and injuries; Whaling masters--Wounds and injuries; Whaling--Massachusetts--New Bedford; Indian Ocean; Description and travel; New Zealand; Rarotonga (Cook Islands); West, David P; Church, Nathan--(Shipowner); Cunningham, John,---1844; Accidents; Whalers (Persons)--Death; Whaling--Massachusetts--Fairhaven; Whaling masters--Death; Honolulu (Hawaii); Rarotonga (Cook Islands)</div>","source":"commons-desc-page"},"Credit":{"value":"<dl><dd><a href=\"//archive.org/details/KWM-785\" class=\"extiw\" title=\"iarchive:KWM-785\"><bdi class=\"description en\" lang=\"en\" dir=\"ltr\">Internet Archive identifier</bdi>: KWM-785</a></dd>\n<dd><a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/download/KWM-785/KWM-785.pdf\">https://archive.org/download/KWM-785/KWM-785.pdf</a></dd></dl>\n<ul><li>IA digitizing sponsor: Boston Public Library</li></ul>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}},"mime":"application/pdf"}],"categories":[{"ns":14,"title":"Category:Books uploaded by F\u00e6"},{"ns":14,"title":"Category:Books without Wikidata item"},{"ns":14,"title":"Category:CC-PD-Mark"},{"ns":14,"title":"Category:Old books from American Libraries"},{"ns":14,"title":"Category:PD-old-100-expired"},{"ns":14,"title":"Category:PD-old missing SDC copyright status"},{"ns":14,"title":"Category:Scans from the Internet Archive"},{"ns":14,"title":"Category:Scans from the Internet Archive/unverified"}]},"117915653":{"pageid":117915653,"ns":6,"title":"File:Kia Soul Juste pour Rire (32706080585).jpg","index":1,"imagerepository":"local","imageinfo":[{"size":2398500,"width":2592,"height":1944,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Kia_Soul_Juste_pour_Rire_%2832706080585%29.jpg/960px-Kia_Soul_Juste_pour_Rire_%2832706080585%29.jpg?utm_source=commons.wikime