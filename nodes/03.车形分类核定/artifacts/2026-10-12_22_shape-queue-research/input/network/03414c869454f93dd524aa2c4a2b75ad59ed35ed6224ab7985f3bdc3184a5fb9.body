                  function objectToQueryString(o){var r=[];for(var t in o){if(!o.hasOwnProperty(t))continue;var n=o[t];if(n!=null){if(typeof n==='function'){n=n.name}r.push(encodeURIComponent(t)+'='+encodeURIComponent(n))}}return r.length?'?'+r.join('&'):''}
                  var queryString = objectToQueryString(ahmConsentSettings);
                  var currentScript = document.getElementsByTagName('script')[0];
                  var consentScript = document.createElement('script');
                  consentScript.async = true;
                  var scriptSrc = ahmConsentSettings.environment == 'PROD'
                      ? 'https://content.services.honda.com/privacyconsent/ahm-privacy-consent.js'
