f_6.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/b/be/Documents_about_Martin_Luther_King%2C_Jr.%2C_Executive_Order_14176%2C_157-no-10673_hs1-852666771_124-01-part_2_of_6.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Documents_about_Martin_Luther_King,_Jr.,_Executive_Order_14176,_157-no-10673_hs1-852666771_124-01-part_2_of_6.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=170517299","extmetadata":{"DateTime":{"value":"2025-07-22 16:11:31","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Documents about Martin Luther King, Jr., Executive Order 14176, 157-no-10673 hs1-852666771 124-01-part 2 of 6","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US Government|Uploaded with OpenRefine|CC-PD-Mark|Documents about Martin Luther King, Jr. released under Executive Order 14176","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"President Donald J. Trump signed Executive Order 14176, <a rel=\"nofollow\" class=\"external text\" href=\"https://www.whitehouse.gov/presidential-actions/2025/01/declassification-of-records-concerning-the-assassinations-of-president-john-f-kennedy/\">Declassification of Records Concerning the Assassinations of President John F. Kennedy, Senator Robert F. Kennedy, and the Reverend Dr. Martin Luther King, Jr.</a>, on January 23, 2025.<br><br>Released: July 21, 2025 - 3:30 PM ET Release: 243,496 pages (6,301 PDF files and 1 MP3 audio file)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.archives.gov/research/mlk\">https://www.archives.gov/research/mlk</a> <a rel=\"nofollow\" class=\"exte