    "Pickup": "皮卡",
    "Chassis Cab": "皮卡",
    "Pritsche/Fahrgestell": "皮卡",
    "Coupe": "跑车",
    "Convertible": "跑车",
    "Roadster": "跑车",
    "Targa": "跑车",
    "Hardtop": "跑车",
    "Phaeton": "跑车",
    "Speedster": "跑车"
